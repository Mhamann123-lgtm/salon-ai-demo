# Set these in Vercel > Project > Settings > Environment Variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Use a private Turnstile widget for real public bookings; never publish without bot protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Twilio SMS: optional until you are ready to send real messages.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Google service account with access to a private staff spreadsheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
# Generate a long random value and use in Vercel cron authentication.
CRON_SECRET=
